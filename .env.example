# =============================================================================
# ViGlobal API (Node) — mẫu biến môi trường. Sao chép thành `.env` và điền giá trị thật.
# Không commit file `.env` lên Git.
# =============================================================================

# --- Bắt buộc cho mọi route dùng Prisma (gồm OTP: EmailOtpChallenge + EmailOtpSendLog) ---
# PostgreSQL connection string (ví dụ Neon / Supabase / Docker local).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# --- Direct/session PostgreSQL URL for Prisma migrate status/deploy (not pooler) ---
# Use direct port (5432) for migration-safe CLI operations. Never commit real secrets.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# --- Bắt buộc cho luồng OTP & JWT session (tối thiểu 16 ký tự) ---
# Nếu thiếu hoặc < 16 ký tự → API trả 500 "Authentication service unavailable" khi gọi /email/otp/request.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-16-ky-tu

# --- Bắt buộc để gửi email OTP qua Amazon SES (EmailService + EmailOtpService) ---
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Địa chỉ From phải đã verify trong SES (Sandbox: cả From và To đều phải verify).
# Hỗ trợ một trong các tên: SES_FROM_EMAIL | MAIL_FROM | AWS_SES_SENDER_EMAIL
AWS_SES_SENDER_EMAIL=you@verified-domain.example
# SES_REGION=eu-north-1

# --- AI Receptionist pilot lead relay (API server; optional) ---
# Inbox nhận lead pilot từ POST /api/ai-receptionist/pilot-leads/email (xem docs/ops/VIONA_COMMERCIAL_PILOT_OPS_RUNBOOK.md).
# VIONA_AI_RECEPTIONIST_LEAD_RECIPIENT_EMAIL=ops-pilot-inbox@example.com

# --- Twilio (sandbox / pilot documentation only — NEVER commit real secrets) ---
# Chỉ bật sau khi có phê duyệt riêng; mặc định sandbox / tắt production calling.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_VOICE_FROM_NUMBER=
# TWILIO_SANDBOX_ENABLED=false
# VIONA_TWILIO_PRODUCTION_CALLS_ENABLED=false
# VIONA_CALL_RECORDING_ENABLED=false
# VIONA_CALL_CONSENT_REQUIRED=true

# --- Pack30D-4 — Twilio Test-Credentials real-provider POC (names only; never real values here) ---
# Distinct from TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above — the adapter reads ONLY these two and
# never falls back to the live credentials. See docs/product/VIONA_REQUEST_PACK30D_REAL_EXECUTION_PLAN.md.
# TWILIO_TEST_ACCOUNT_SID=
# TWILIO_TEST_AUTH_TOKEN=
# Pack30D-7 — deployment identity (separate from NODE_ENV). Real Twilio executeReal() is allowed
# ONLY when VIONA_DEPLOYMENT_STAGE=staging AND PACK30_REAL_PROVIDER_EXECUTION_ENABLED=true.
# Local/dev/unknown stages and production deployment stage always fail closed.
# VIONA_DEPLOYMENT_STAGE=development
# Default false — never enable at code-level; set via Fly secrets on staging when authorized.
# PACK30_REAL_PROVIDER_EXECUTION_ENABLED=false

# --- Pack30D-5 — Real-Provider spend Circuit Breaker (per-provider daily USD-cent cap). Missing
# or non-numeric resolves to a 0 cap, which is ALWAYS open (blocks 100% of real-provider calls) —
# fail-closed by design, never "unlimited". Currently wired only into the Twilio adapter above;
# the OpenAI entry exists for a future, separately authorized real-execution adapter and is not
# read by any live OpenAI call path today. See docs/internal-ops/VIONA_PACK30D_5_REAL_PROVIDER_PLAN.md.
# PACK30D5_TWILIO_DAILY_CAP_USD_CENTS=500
# PACK30D5_OPENAI_DAILY_CAP_USD_CENTS=500
# Default false; hard-blocked in production regardless of this value. Gates the new, UNWIRED
# vionaOpenAiRealProviderAdapter.ts only — never AIRouterService.ts's existing
# createRoutedChatCompletion() call sites (chat/translation/marketing-draft/legal-scan), which
# remain ungated by this flag, exactly as before this pack.
# PACK30D_OPENAI_REAL_EXECUTION_ENABLED=false

# --- Pack30D-8 — Internal real Twilio POC HTTP route (staging/local only; operator phrase required) ---
# POST /api/internal/viona/trigger-real-twilio-poc — blocked on production/unknown deployment stage.
# Still requires PACK30_REAL_PROVIDER_EXECUTION_ENABLED=true + Twilio Test Credentials on the server.
# Forces Twilio magic number +15005550006 (zero-cost Test Credentials path only).

# --- Pack31 — dev/test-only mock payment adapter (VIO Credits top-up for exercising the escrow
# hold flow without a real Stripe checkout). Default false; hard-blocked in production regardless
# of this value. See docs/product/VIONA_PACK31_FINANCIAL_ESCROW_PLAN.md §6.
# PACK31_MOCK_PAYMENT_ADAPTER_ENABLED=false

# --- Tuỳ chọn API server ---
# API_PORT=8787

# --- API hardening (Express + Socket.IO) ---
# API_CORS_ORIGINS=https://your-app.example.com,http://localhost:8081
# TRUST_PROXY_HOPS=0
