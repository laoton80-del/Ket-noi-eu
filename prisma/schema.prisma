// ViGlobal user domain — align with product spec (phone + PIN, tiers, B2B businesses).
// Run in a Node service: npm i -D prisma && npm i @prisma/client && npx prisma validate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  B2C
  B2B
  /// EU / diaspora B2B merchant (legacy `B2B` treated as EU in product copy where needed).
  B2B_EU
  /// Vietnam domestic vendor (taxi, homestay, F&B) — QR payouts + platform commission.
  B2B_VN
  ADMIN
  /// Field broker / Mica affiliate — onboards merchants + earns fee-share on fulfilled tourism.
  BROKER
}

enum UserTier {
  STANDARD
  POWER
  ELITE
}

enum TxType {
  P2P
  BOOKING
  BOOKING_LOCK
  TOPUP
  WITHDRAW
  CHARITY_FEE
  ESCROW_LOCK
  ESCROW_REFUND
  PENALTY_FEE
  AI_LEGAL_SCAN
  LESSON_REWARD
  PLATFORM_FEE
  /// Tourist → VN merchant QR settlement (split: platform fee + vendor net).
  QR_MERCHANT
  /// Pack31 — VionaRequest execution-hold settle leg (VIO Credits actually consumed after a real-provider
  /// call resolves). Distinct from the generic `PLATFORM_FEE` so VionaRequest ledger reporting stays
  /// separable from other verticals' platform-fee legs.
  VIONA_REQUEST_EXECUTION_SETTLED
  /// Broker commission credit (Mica / affiliate) paid from treasury on fulfilled inbound tourism.
  BROKER_COMMISSION
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BrokerEscrowStatus {
  PENDING_CLEARANCE
  RELEASED
  CANCELLED_CHARGEBACK
  CANCELLED_FRAUD_WASH
  CANCELLED_OTHER
}

enum BrokerEscrowKind {
  PAYG_AI_NET_SHARE
  B2B_POWER_SUBSCRIPTION
  ACTIVATION_BOUNTY
  LEADERSHIP_BONUS
}

/// Vietnam inbound hub — B2B verticals (+84 merchants) surfaced to tourists & expats.
enum BizType {
  HOTEL
  HOMESTAY
  TOUR_OPERATOR
  LOCAL_EXPERIENCE
  RESTAURANT
  TRANSPORT
}

enum BookStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TourismBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Wallet settlement lifecycle for tourism bookings (legacy vs hold vs confirm).
enum TourismSettlementMode {
  UNKNOWN
  LEGACY_SETTLE_ON_BOOK
  HOLD_ON_SUBMIT
  SETTLE_ON_CONFIRM
  PREVIEW_ONLY
}

/// Local universe service request lifecycle (merchant ACK before settlement when hold enabled).
enum LocalServiceRequestStatus {
  DRAFT
  REQUESTED
  MERCHANT_REVIEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REJECTED
  USER_CANCELLED
  OPS_CANCELLED
  EXPIRED
}

/// Local request wallet policy — default REQUEST_ONLY_NO_CHARGE until finance enables hold pilot.
enum LocalWalletMode {
  NO_LEDGER_PREVIEW
  REQUEST_ONLY_NO_CHARGE
  HOLD_ON_SUBMIT
  SETTLE_ON_CONFIRM
  LEGACY_BOOKING_BRIDGE
}

/// Ledger phase snapshot for Local requests (parallel to tourism walletPhase derivation).
enum LocalWalletPhase {
  NONE
  HELD
  SETTLED
  RELEASED
  REFUNDED
  LEGACY_BRIDGE
  PREVIEW
}

enum LocalRequestSource {
  LOCAL_SCREEN
  FIXER_CHECKOUT
  LEONA_ASSIST
  LEGAL_SCAN
  ADMIN_SEED
  API_DIRECT
}

enum LocalServiceType {
  SERVICE_MENU
  FIXER_HIRE
  GENERIC_REQUEST
  LEGAL_INTAKE
  CLASSIFIED_LEAD
}

enum LocalCancelReason {
  USER_CANCEL
  PROVIDER_REJECTED
  EXPIRED
  OPS_CANCEL
  SYSTEM_SAFETY_RELEASE
  INSUFFICIENT_FUNDS
  OTHER
}

/// Append-only Local request lifecycle audit event type (AUDIT_RUNTIME_1).
enum LocalServiceRequestAuditEventType {
  REQUEST_CREATED
  MERCHANT_REVIEW_STARTED
  MERCHANT_CONFIRMED
  MERCHANT_REJECTED
  USER_CANCELLED
  OPS_CANCELLED
  REQUEST_EXPIRED
  EXPIRY_DRY_RUN_IDENTIFIED
  EXPIRY_APPLY_ATTEMPTED
  EXPIRY_APPLY_SKIPPED_RACE_CONDITION
  EXPIRY_APPLY_COMPLETED
}

/// Actor attribution for Local request audit rows (human, ops, system, future AI).
enum LocalServiceRequestAuditActorType {
  REQUESTER
  MERCHANT
  OPS
  SYSTEM
  AI_COPILOT_READ_ONLY
  AI_ACTION_ASSISTANT_FUTURE
}

/// Local provider eligibility lifecycle (FC-P0 Local provider authority).
enum LocalProviderEligibilityStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

/// Append-only eligibility authority audit event types (FC-P0).
enum LocalProviderEligibilityAuditEventType {
  REGISTERED
  CONFIG_UPDATED
  ACTIVATED
  SUSPENDED
  RETIRED
}

/// Authority-class snapshot for eligibility audit actors (FC-P0: Role.ADMIN only).
enum LocalProviderEligibilityAuditActorType {
  ROLE_ADMIN
}

enum PayStatus {
  UNPAID
  DEPOSIT_PAID
  FULL_PAID
}

enum DocType {
  PASSPORT
  VISA
  GREEN_CARD
}

/// Travel hub purchase line (UI copy may say “eSIM”; value is `ESIM`).
enum TravelType {
  FLIGHT
  CHAUFFEUR
  FAST_TRACK
  TELEHEALTH
  ESIM
}

/// Extend in migrations if you need paid vs fulfilled vs refunded granularity.
enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
}

enum AIPersona {
  LEONA
  MINH_KHANG
  TEACHER
  RECEPTIONIST
}

/// Human-in-the-loop AI social posts — cron creates `DRAFT` only; Meta publish is manual.
enum MarketingPostStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

/// LLM router task labels — drives model tier (mini vs full) in `AIRouterService`.
enum LlmRouterTaskType {
  SIMPLE_TRANSLATION
  ROUTING_INQUIRY
  COMPLEX_MARKETING
  DEEP_CONTEXT
  /// Pack30D-5 — dedicated, isolated task type for the new, unwired
  /// `vionaOpenAiRealProviderAdapter.ts` (see docs/internal-ops/VIONA_PACK30D_5_REAL_PROVIDER_PLAN.md
  /// §4). Never used by any existing, already-shipped OpenAI call site (chat/translation/legal-scan/
  /// marketing-draft) — this isolation lets the Circuit Breaker's spend-window query count only
  /// this adapter's own usage.
  VIONA_REAL_EXECUTION_CONTENT
}

model User {
  id              String   @id @default(uuid())
  phoneNumber     String   @unique // E.164 prefix checks: +84, +49, +420, …
  role            Role     @default(B2C)
  pinCode         String // App / transaction gate — store hash only at application layer
  tier            UserTier @default(STANDARD)
  createdAt       DateTime @default(now())
  viStarPoints    Int      @default(0) // ViStar: kid-facing virtual points (no cash value)
  /// Anti-fraud fiat cashout: future Withdrawal API MUST allow initiation only when
  /// `userType === "B2B"` AND `isKYCVerified === true` (never for unverified B2C).
  isKYCVerified Boolean @default(false)
  /// Segment label aligned with product (e.g. `"B2C"` | `"B2B"`). Enforce at withdrawal time with `isKYCVerified`.
  userType      String  @default("B2C")
  /// B2B subscription tier: `"BASIC"` | `"ELITE"`.
  subscriptionPlan   String    @default("BASIC")
  subscriptionExpiry DateTime?
  /// Product routing: diaspora vs inbound Vietnam travel (`EXPAT` | `TOURIST`).
  persona              String    @default("EXPAT")
  /// VN B2B vendor vertical: `TAXI` | `HOMESTAY` | `FOOD` | … (free text for reporting).
  businessCategory     String?
  /// GDPR erasure completed — no PII processing beyond legal retention.
  gdprErasedAt         DateTime?

  /// Expo / FCM device push token (Expo abstracts native FCM/APNs). Nullable until client registers.
  fcmToken             String?
  /// Verified contact for Zero-SMS auth and transactional email (optional until linked).
  email                String?   @unique
  emailVerifiedAt      DateTime?

  profile            Profile?
  wallet             Wallet?
  businesses         Business[]
  bookings           Booking[]
  tourismBookings    TourismBooking[]
  localServiceRequestsRequested LocalServiceRequest[] @relation("LocalServiceRequestRequester")
  localServiceRequestsAssigned  LocalServiceRequest[] @relation("LocalRequestAssignedProvider")
  secureVaults       SecureVault[]
  travelOrders       TravelOrder[]
  aiLogs             AILog[]
  llmApiUsageLogs    LlmApiUsageLog[]
  piggyBanksFunded   PiggyBank[] @relation("PiggyBankParentUser")
  piggyBanksForChild PiggyBank[] @relation("PiggyBankChildUser")
  /// Businesses acquired via Mica / broker field kit (`Business.brokerId`).
  brokeredBusinesses Business[] @relation("BrokerAcquiredBusiness")
  /// Optional upline (master broker) for leadership bonus — enforce `Role.BROKER` in app layer.
  masterBrokerId String?
  masterBroker     User?   @relation("BrokerHierarchy", fields: [masterBrokerId], references: [id], onDelete: SetNull)
  subBrokers       User[]  @relation("BrokerHierarchy")
  brokerEscrows    BrokerCommissionEscrow[] @relation("EscrowBeneficiary")
  /// Opaque refresh sessions (hash-only); cascade on user delete (GDPR).
  authRefreshSessions AuthRefreshSession[]
  /// Local provider eligibility audit rows where this user acted as Role.ADMIN.
  localProviderEligibilityAuditEvents LocalProviderEligibilityAuditEvent[]

  @@index([masterBrokerId])
}

/// Refresh token session — opaque token stored only as **SHA-256 hex** on server; rotation via `replacementSession`.
model AuthRefreshSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex (64 chars) of `crypto.randomBytes(32).toString('hex')` — never store plaintext refresh.
  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  /// After rotation: this row points to the new session. Null = active tail or not yet rotated-from.
  replacedBySessionId String? @unique
  replacementSession  AuthRefreshSession?  @relation("AuthRefreshRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  supersededSessions    AuthRefreshSession[] @relation("AuthRefreshRotation")

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

/// Short-lived email OTP for sign-up / verification (Zero-SMS Doctrine).
model EmailOtpChallenge {
  id           String   @id @default(uuid())
  email        String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([email])
}

/// Append-only audit of OTP send attempts — used for per-email rate limiting (SES cost / abuse).
model EmailOtpSendLog {
  id        String   @id @default(uuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// Deduplicated AI text translation — hash lookup avoids repeat OpenAI spend (P2: $0 on hit).
model TranslationCache {
  id             String   @id @default(uuid())
  /// Normalized source (trimmed, collapsed whitespace) — stored for audit/debug.
  sourceText     String
  /// BCP-47-ish tag, e.g. `vi`, `en`, `de`.
  targetLanguage String
  translatedText String
  /// SHA-256 hex of normalized `sourceText` + `targetLanguage` — unique index = O(1) lookup.
  hash           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Tracks referred-merchant QR booking completions toward the 500 VIG activation bounty (fraud-gated).
model MerchantBrokerActivation {
  businessId               String   @id
  activationBountyEscrowId String?  @unique
  bountyAwarded            Boolean  @default(false)
  updatedAt                DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// All broker commissions & bounties default to **pending clearance** (~7d) before spendable release.
model BrokerCommissionEscrow {
  id                       String             @id @default(uuid())
  beneficiaryUserId        String
  amountVIG                Float
  kind                     BrokerEscrowKind
  status                   BrokerEscrowStatus @default(PENDING_CLEARANCE)
  createdAt                DateTime           @default(now())
  clearAt                  DateTime
  releasedAt               DateTime?
  idempotencyKey           String             @unique
  stripePaymentIntentId    String?
  paymentMethodFingerprint String?
  underlyingKngNetVig      Float?
  merchantBusinessId       String?
  sourceBookingId          String?
  pendingTransactionId     String?            @unique

  beneficiary User @relation("EscrowBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@index([status, clearAt])
  @@index([beneficiaryUserId, status])
}

/// Parent-pre-funded lesson rewards (VIG never minted by treasury — only released from `lockedVigAmount`).
model PiggyBank {
  id               String    @id @default(uuid())
  parentId         String
  childId          String
  lockedVigAmount  Float     @default(0)
  rewardPerLesson  Float     @default(0)
  /// Set on create (e.g. now + 30 days). Expired piggy blocks lesson VIG; cron refunds remainder to parent wallet.
  expiresAt        DateTime?

  parent User @relation("PiggyBankParentUser", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("PiggyBankChildUser", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([expiresAt])
}

model Profile {
  id           String  @id @default(uuid())
  userId       String  @unique
  fullName     String
  avatarUrl    String?
  country      String // Display or ISO; app copy: Đức, Séc, Pháp, Mỹ…
  languageCode String  @default("vi") // Smart trio: vi | en | local

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id               String  @id @default(uuid())
  userId           String  @unique
  /// Spendable VIG (EUR-pegged 1:1). Booking pre-auth moves funds here → `lockedBalanceVIG`.
  balanceVIG       Float   @default(0)
  /// VIG held for active booking commitments (not spendable until release or cancel rules apply).
  lockedBalanceVIG Float   @default(0)
  stripeCustId     String? // Stripe Customer id (gateway link)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

/// Ledger line stored against the wallet whose history UI/API loads (`walletId`).
/// For P2P you may write two rows (debit/credit) sharing a correlation id in app layer, or one row per party.
model Transaction {
  id         String   @id @default(uuid())
  walletId   String
  senderId   String // User id or sentinel e.g. `System` for top-ups
  receiverId String
  amountVIG  Float
  feeAmount  Float    @default(0) // ViGlobal fee (e.g. 2.5% or split-fee)
  type       TxType
  status     TxStatus
  createdAt  DateTime @default(now())
  /// Prevents double AI / billing debits when clients retry the same request id.
  idempotencyKey String? @unique

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([senderId, receiverId])
}

/// Stripe webhook idempotency — never double-credit VIG on event replay.
model ProcessedStripeEvent {
  id              String   @id @default(uuid())
  stripeEventId   String   @unique
  eventType       String
  paymentIntentId String?
  createdAt       DateTime @default(now())
}

/// Singleton aggregate for live CSR counter on Home (enforce one row in app migrations / seed).
model CharityFund {
  id             Int      @id @default(1)
  totalAmountVIG Float    @default(0)
  updatedAt      DateTime @updatedAt
}

/// Immutable audit trail: **1% of KNG net revenue** per settled platform event (source of truth for Hub charity UI).
model CharityLedgerEntry {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  kngNetRevenueVig   Float
  charityAccrualVig  Float
  sourceKind         String
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

model Business {
  id           String    @id @default(uuid())
  ownerId      String // B2B User id
  /// Optional broker (`Role.BROKER`) who placed the Mica gold QR / acquired this merchant.
  brokerId     String?
  /// Dynamic deep-link / universal URL encoded on the merchant’s physical Mica sign.
  qrCodeUrl    String?
  name         String
  category     BizType
  locationLat  Float
  locationLng  Float
  description  String    @default("")
  isTopAd      Boolean   @default(false) // 90-day featured placement
  adExpiryDate DateTime?
  /// Omniversal Prime: anchor for 90-day free top-rank trial + paid lock-in ladder.
  joinedAt                 DateTime  @default(now())
  /// High placement in discovery / ad slots (trial or paid credits).
  isPremiumRank            Boolean   @default(true)
  /// VIG balance reserved for sponsored ranking after trial (burned daily while active).
  paidAdCredits            Float     @default(0)
  /// UTC anchor for idempotent daily `paidAdCredits` burn (post–day-90 only).
  lastAdCreditDeductionAt  DateTime?
  /// NAPAS acquirer BIN (6 digits) for VietQR EMV — e.g. VietinBank `970415`.
  vietQrBankBin         String?
  /// Domestic bank account number printed on VietQR.
  vietQrAccountNumber   String?
  /// Beneficiary name as registered with the bank (VietQR display / NAPAS).
  vietQrAccountName     String?

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  broker           User?             @relation("BrokerAcquiredBusiness", fields: [brokerId], references: [id], onDelete: SetNull)
  services         Service[]
  bookings         Booking[]
  tourismServices  TourismService[]
  tourismBookings  TourismBooking[]
  localServiceRequests LocalServiceRequest[]
  brokerActivation MerchantBrokerActivation?
  localProviderEligibility LocalProviderEligibility?

  @@index([ownerId])
  @@index([category, locationLat, locationLng])
}

/// Bookable offering under a B2B business (minimal shape — extend price/duration in migrations).
model Service {
  id         String @id @default(uuid())
  businessId String
  name       String
  priceVIG   Float  @default(0) // List price (VIG 1:1 EUR); booking locks 100% at create time

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]
  localServiceRequests LocalServiceRequest[]

  @@index([businessId])
}

model Booking {
  id                     String     @id @default(uuid())
  userId                 String // B2C booker
  businessId             String
  serviceId              String
  /// GLOBAL STANDARD: stored as UTC instant only. API accepts ISO 8601 with `Z` or explicit offset — never naive local strings.
  timeSlot               DateTime
  status                 BookStatus
  paymentStatus          PayStatus
  /// Full list-price VIG pre-authorized at booking (moved from wallet `balanceVIG` → `lockedBalanceVIG`).
  lockedAmountVIG        Float      @default(0)
  /// 10% platform commission (VIG) collected from B2B on successful QR completion — persisted for reporting.
  platformFeeVIG        Float      @default(0)
  /// SHA-256 hex of one-time QR completion token (issued when `lockedAmountVIG > 0`). Never store plaintext token.
  completionQrTokenHash String?
  /// Set if a card rail later disputes / refunds (broker bounty fraud checks).
  refundedAt DateTime?
  /// Optional Stripe PI when checkout is card-backed (chargeback verification on escrow release).
  stripePaymentIntentId String?
  /// Stripe `payment_method` fingerprint or synthetic `VIG_BOOKER:<userId>` for wallet-only QR.
  paymentMethodFingerprint String?
  /// Set when `status` becomes `COMPLETED` (activation bounty + audit).
  completedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  localServiceRequest LocalServiceRequest?

  @@index([userId, timeSlot])
  @@index([businessId, timeSlot])
}

/// Local universe merchant service request — durable SoT before commercial ACK/wallet packs.
/// See docs/architecture/VIONA_LOCAL_REQUEST_SCHEMA_DESIGN_1.md
model LocalServiceRequest {
  id String @id @default(uuid())

  requesterUserId String
  businessId      String

  serviceId            String?
  fixerProfileKey      String?
  assignedProviderUserId String?
  legacyBookingId      String? @unique

  serviceType LocalServiceType
  category    BizType?
  title       String
  description String  @default("")
  locationText String?
  city         String?
  countryCode  String?

  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  requestedAt      DateTime @default(now())
  merchantReviewDeadlineAt DateTime?

  confirmedAt       DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?
  expiredAt         DateTime?
  providerSettledAt DateTime?

  status     LocalServiceRequestStatus @default(REQUESTED)
  walletMode LocalWalletMode           @default(REQUEST_ONLY_NO_CHARGE)
  walletPhase LocalWalletPhase         @default(NONE)

  totalVioCredits            Float?
  heldVioCredits             Float?
  releasedVioCredits         Float?
  platformFeeVioCredits      Float?
  providerEarningsVioCredits Float?

  cancelReason    LocalCancelReason?
  rejectReason    LocalCancelReason?
  cancelledByRole String?
  source          LocalRequestSource
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester        User     @relation("LocalServiceRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedProvider User?    @relation("LocalRequestAssignedProvider", fields: [assignedProviderUserId], references: [id], onDelete: SetNull)
  legacyBooking    Booking? @relation(fields: [legacyBookingId], references: [id], onDelete: SetNull)
  auditEvents      LocalServiceRequestAuditEvent[]

  @@index([requesterUserId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, merchantReviewDeadlineAt])
  @@index([status, walletPhase])
  @@index([status, merchantReviewDeadlineAt])
  @@index([walletMode])
  @@index([legacyBookingId])
}

/// Append-only audit trail for LocalServiceRequest lifecycle (no wallet mutation from writer).
/// See docs/architecture/VIONA_LOCAL_REQUEST_AUDIT_LOG_DESIGN_1.md
model LocalServiceRequestAuditEvent {
  id        String @id @default(uuid())
  requestId String

  eventType LocalServiceRequestAuditEventType
  actorType LocalServiceRequestAuditActorType

  actorUserId String?
  businessId  String?

  fromStatus LocalServiceRequestStatus?
  toStatus   LocalServiceRequestStatus?

  reason      String?
  safeMessage String?
  metadataJson Json?

  noWalletAction               Boolean @default(true)
  walletPhaseSnapshot          LocalWalletPhase?
  walletModeSnapshot           LocalWalletMode?
  requestOnlyNoChargeSnapshot  Boolean @default(true)

  idempotencyKey String?
  runId          String?

  createdAt DateTime @default(now())

  request LocalServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorType, createdAt])
  @@index([runId])
  @@index([idempotencyKey])
}

/// 1:1 Local provider eligibility authority for a Business (FC-P0).
/// No row ⇒ Business is not Local-eligible. Reasons live only on audit events.
model LocalProviderEligibility {
  id        String @id @default(uuid())
  businessId String @unique

  status                LocalProviderEligibilityStatus @default(DRAFT)
  publicB2cVisible      Boolean                       @default(false)
  supportedServiceTypes LocalServiceType[]            @default([])

  activatedAt DateTime?
  suspendedAt DateTime?
  retiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business                           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  auditEvents LocalProviderEligibilityAuditEvent[]

  @@index([status, publicB2cVisible])
}

/// Append-only Local provider eligibility authority audit (FC-P0).
/// Production code must not update/delete rows — create only (Pack A2 writers).
model LocalProviderEligibilityAuditEvent {
  id String @id @default(uuid())

  eligibilityId String
  businessId    String

  eventType   LocalProviderEligibilityAuditEventType
  actorType   LocalProviderEligibilityAuditActorType
  actorUserId String

  priorStatus LocalProviderEligibilityStatus?
  nextStatus  LocalProviderEligibilityStatus

  priorPublicB2cVisible Boolean?
  nextPublicB2cVisible  Boolean

  priorSupportedServiceTypes LocalServiceType[] @default([])
  nextSupportedServiceTypes  LocalServiceType[] @default([])

  reason String?

  createdAt DateTime @default(now())

  eligibility LocalProviderEligibility @relation(fields: [eligibilityId], references: [id], onDelete: Restrict)
  actorUser   User                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([eligibilityId, createdAt])
  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

/// Inbound tourism catalog line (hotels, tours, fixers, F&B) — distinct from legacy `Service` / `Booking`.
model TourismService {
  id          String   @id @default(uuid())
  businessId  String
  title       String
  priceVIG    Float    @default(0)
  description String   @default("")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tourismBookings TourismBooking[]

  @@index([businessId])
}

model TourismBooking {
  id         String                 @id @default(uuid())
  userId     String
  businessId String
  serviceId  String
  startDate  DateTime
  endDate    DateTime
  guestCount Int
  status     TourismBookingStatus
  /// 5% ViGlobal commission taken from the Vietnamese provider’s share of list base.
  providerFeeVIG Float @default(0)
  /// 5–7% “Trust & AI Shield” fee on the tourist (applied to base list amount).
  touristFeeVIG Float @default(0)
  /// Gross deducted from tourist spendable wallet: base list + `touristFeeVIG`.
  totalPaidVIG Float @default(0)
  /// Provider wallet credit: base list − `providerFeeVIG`.
  netProviderEarningsVIG Float @default(0)
  /// Share of platform fees routed to `Business.brokerId` when booking is marked COMPLETED.
  brokerCommissionVIG    Float     @default(0)
  brokerCommissionPaidAt DateTime?
  /// Snapshot: `providerFeeVIG + touristFeeVIG` at completion (gross platform fee pool on the booking).
  grossPlatformFeePoolVIG  Float @default(0)
  /// After estimated acquirer allocation — ViGlobal net platform revenue attributable to this booking (audit; broker payout uses net-revenue-share outside tourism).
  kngNetPlatformRevenueVIG Float @default(0)
  /// EUR→VND spot locked at booking time (VIG ≡ EUR) — cash / VietQR off-ramp reconciliation.
  lockedEurVndRate Float?
  fxLockedAt       DateTime?
  /// Rounded VND equivalent of `totalPaidVIG` at `fxLockedAt` (display + local bank transfer hint).
  offRampVndHint   Int?

  /// Row creation time; backfill from `fxLockedAt` for pre-migration rows (`LEGACY_SETTLED_BACKFILL.1`).
  createdAt DateTime?
  updatedAt DateTime? @updatedAt
  /// Non-null when provider/treasury wallet credits have executed.
  providerSettledAt DateTime?
  /// Merchant ACK timestamp when `status` becomes CONFIRMED.
  confirmedAt DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  settlementMode TourismSettlementMode @default(UNKNOWN)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  TourismService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([userId, startDate])
  @@index([businessId, startDate])
  @@index([status, providerSettledAt])
  @@index([businessId, status])
  @@index([settlementMode])
}

/// Encrypted blob only — never store plaintext identity docs in `encryptedData`.
model SecureVault {
  id            String   @id @default(uuid())
  userId        String
  documentType  DocType
  encryptedData String // AES-256 ciphertext + IV metadata as produced by your crypto layer
  uploadedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType])
}

model TravelOrder {
  id            String      @id @default(uuid())
  userId        String
  orderType     TravelType
  referenceCode String // Airline PNR / partner ref
  amountVIG     Float
  status        OrderStatus

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([referenceCode])
}

/// OpenAI chat completion usage — model + token counts for cost auditing (router-selected tier).
model LlmApiUsageLog {
  id               String            @id @default(uuid())
  taskType         LlmRouterTaskType
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime          @default(now())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([taskType, createdAt])
  @@index([model, createdAt])
}

/// Per-call AI usage / billing audit (e.g. “Translate Menu”, “Call Booking”).
model AILog {
  id           String    @id @default(uuid())
  userId       String
  persona      AIPersona
  action       String // e.g. "Translate Menu", "Call Booking"
  tokensBurned Float // VIG-equivalent burn for this AI invocation
  timestamp    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([persona, timestamp])
}

/// Facebook / social copy drafted by cron or manual trigger — admin approves before Graph API publish.
model MarketingPost {
  id                  String              @id @default(uuid())
  content             String
  /// Human-approved source text for polyglot translation + optional official Page publish.
  approvedBaseContent String?
  status              MarketingPostStatus @default(DRAFT)
  createdAt           DateTime            @default(now())
  publishedAt         DateTime?
  translations        MarketingTranslation[]

  @@index([status, createdAt])
}

/// Localized ammunition for manual paste into third-party Facebook Groups (no automated group posting).
model MarketingTranslation {
  id                 String @id @default(uuid())
  postId             String
  languageCode       String
  translatedContent  String
  targetAudience     String

  post MarketingPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, languageCode])
  @@index([postId])
}

// --- VIONA Request Engine (Dedicated Request Store) — Pack13C schema only ---
// NOT wired to runtime. NOT migration. NOT payment/booking/SOS/wallet truth.
// See docs/product/VIONA_REQUEST_PACK13C_PRISMA_SCHEMA_IMPLEMENTATION_SCHEMA_ONLY.md

/// Pack34 — B2B Merchant Gateway & AI White-Labeling: per-merchant tenant-isolation anchor.
/// See docs/product/VIONA_PACK34_B2B_MERCHANT_GATEWAY_PLAN.md §3. `tenantId` is `@unique` — a
/// strict 1:1 mapping onto the pre-existing, free-text `VionaRequest.tenantId` column, closing the
/// gap where that column had zero enforcement (no FK, no isolation check at the query layer).
/// Deliberately independent of the existing `Business`/`BizType` model (§3.4 of the plan) — that
/// model answers "where can a customer discover/book this merchant"; this one answers "which AI
/// context/tools/wallet may this merchant's AI Receptionist use." No relation between them is
/// added by this pack.
model MerchantProfile {
  id            String   @id @default(uuid())
  /// The B2B `User` (`Role.B2B` / `B2B_EU` / `B2B_VN`) that owns/administers this profile. Reuses
  /// that user's existing, single `Wallet` row for any future escrow hold — never a second wallet.
  ownerUserId   String   @unique
  /// Must equal the exact `VionaRequest.tenantId` string this merchant's requests carry.
  tenantId      String   @unique
  displayName   String
  countryCode   String?
  defaultLocale String?
  /// `VionaMerchantAiPersona` shape (src/lib/viona/merchant/vionaMerchantAiPersonaTypes.ts).
  /// Nullable by design — `resolveMerchantAiPersona()` treats a missing/malformed value as the
  /// documented, safe default persona; it never throws and never leaves "no persona" undefined.
  aiPersona     Json?
  /// Allowlist of `VIONA_TOOL_REGISTRY` `name`s this merchant may invoke. Empty array (the
  /// default) = no tools — fail-closed.
  toolScope     String[] @default([])
  /// Fail-closed default: provisioning a row grants no AI capability until explicitly activated.
  /// The activation workflow itself (who may flip this, under what approval) is explicitly NOT
  /// designed by Pack34 — see the plan's §9 non-goals — so no public setter for this field ships
  /// in this increment; it is only ever `false` at creation.
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  vionaRequests VionaRequest[]
}

/// Pack35 — B2B Omni-Channel Webhook & Agent Routing: maps an external channel identity (a
/// WhatsApp Business phone_number_id, a custom client's own channel id, etc.) to exactly one
/// MerchantProfile, so an inbound webhook payload's own claimed identity is never trusted — only
/// this table's row, resolved by (channelType, channelExternalId), determines which tenantId a
/// webhook message may create a VionaRequest under. See
/// docs/product/VIONA_PACK35_B2B_WEBHOOK_ROUTING_PLAN.md §4.3.
model VionaMerchantWebhookChannel {
  id                String   @id @default(uuid())
  /// References MerchantProfile.id by id only — no Prisma relation, mirroring the existing
  /// VionaRequestEscrowHold.holdTransactionId "id only, no Prisma relation" pattern already used
  /// in this same schema. Adds zero modification to the existing MerchantProfile model.
  merchantProfileId String
  /// 'whatsapp' | 'custom_client' today — plain String, mirrors MerchantProfile.toolScope's own
  /// "no new enum for an evolving, additive value set" convention.
  channelType       String
  /// e.g. a WhatsApp Business phone_number_id, or a client-issued channel id.
  channelExternalId String
  /// Hashed at rest — the raw signing secret is never stored/logged in plaintext.
  signingSecretHash String
  /// Fail-closed default, same convention as MerchantProfile.isActive — provisioning a channel
  /// binding must never, by itself, accept a live webhook until explicitly activated.
  isActive          Boolean  @default(false)
  /// Fail-closed default. Only when true may this channel's resolved tool be auto-approved — and
  /// only for a tool that is merchantScopedOnly + category 'merchant_read_only_query' + present
  /// in the merchant's own toolScope (see vionaMerchantWebhookApprovalGate.ts). A human (the
  /// merchant admin) sets this once, in advance — never inferred, never defaulted to true.
  standingApprovalForReadOnlyToolsOnly Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([channelType, channelExternalId])
  @@index([merchantProfileId])
}

enum VionaRequestSourceLinkStatus {
  PENDING
  ACTIVE
  BROKEN
  SUPERSEDED
}

/// Pack40P — server-owned request provenance (creation-path classification, not actor account type).
enum VionaRequestScopeKind {
  consumer
  merchant
  legacyUnresolved
}

/// Core VIONA request aggregate — lifecycle status does not imply payment, booking, or SOS truth.
model VionaRequest {
  id              String    @id @default(uuid())
  tenantId        String
  requesterUserId String?
  ownerUserId     String?
  sourceUniverse  String
  sourceFeature   String?
  requestType     String
  /// Domain lifecycle string (draft, submitted, triage, …) — not payment or booking confirmation.
  status          String    @default("draft")
  title           String
  summary         String    @default("")
  locale          String?
  countryCode     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?
  metadataJson    Json?
  /// Pack40P — server-owned provenance; DB default fail-safe until create paths assign explicitly.
  scopeKind         VionaRequestScopeKind @default(legacyUnresolved)
  merchantProfileId String?
  merchantProfile   MerchantProfile?      @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)

  participants          VionaRequestParticipant[]
  sourceLinks           VionaRequestSourceLink[]
  statusEvents          VionaRequestStatusEvent[]
  auditEvents           VionaRequestAuditEvent[]
  attachmentReferences  VionaRequestAttachmentReference[]
  escrowHolds           VionaRequestEscrowHold[]
  executionAttempts    VionaRequestExecutionAttempt[]

  @@index([tenantId])
  @@index([status])
  @@index([sourceUniverse])
  @@index([createdAt])
  @@index([scopeKind])
  @@index([merchantProfileId])
}

/// Request participants — participantRoleLabel is local to the request, not Prisma/Auth OPERATOR.
model VionaRequestParticipant {
  id                   String   @id @default(uuid())
  requestId            String
  userRef              String?
  participantRoleLabel String?
  displayName          String?
  contactEmail         String?
  contactPhone         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// Future bridge mapping metadata — not legacy local-service-request SoT; no payment/booking/SOS truth.
model VionaRequestSourceLink {
  id               String                      @id @default(uuid())
  requestId        String
  sourceSystem     String
  sourceEntityType String
  sourceEntityId   String
  linkStatus       VionaRequestSourceLinkStatus @default(PENDING)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([sourceSystem, sourceEntityType, sourceEntityId])
}

/// Append-only lifecycle transition events — no payment/booking/SOS confirmation truth.
model VionaRequestStatusEvent {
  id              String   @id @default(uuid())
  requestId       String
  fromStatus      String?
  toStatus        String
  changedByUserId String?
  reason          String?
  createdAt       DateTime @default(now())

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

/// Append-only audit events — not a payment ledger.
model VionaRequestAuditEvent {
  id             String   @id @default(uuid())
  requestId      String
  eventType      String
  actorUserId    String?
  actorRoleLabel String?
  message        String?
  payloadJson    Json?
  createdAt      DateTime @default(now())
  /// Pack33 — resolved VionaPiiScrubRegion at write time (see vionaPiiScrubber.ts), frozen so a
  /// later change to the parent VionaRequest.countryCode never silently changes a past row's
  /// retention policy. Nullable/additive — existing rows read null until backfilled.
  retentionRegion String?
  /// Pack33 — set once by the (not-yet-scheduled) retention batch job when this row's PII content
  /// has been anonymized in place; null = not yet anonymized. Never cleared once set.
  anonymizedAt    DateTime?

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

/// Opaque attachment metadata/reference only — no OCR or live action execution.
model VionaRequestAttachmentReference {
  id          String   @id @default(uuid())
  requestId   String
  storageKey  String?
  externalRef String?
  filename    String?
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// Pack31 — Financial Gateway & Escrow. Links a VionaRequest execution attempt to the existing,
/// unmodified `Wallet`/`Transaction` ledger (see docs/product/VIONA_PACK31_FINANCIAL_ESCROW_PLAN.md
/// §4.1). Deliberately NOT a second wallet — `Wallet.balanceVIG`/`lockedBalanceVIG` remain the one
/// and only balance source of truth; this table only tracks the hold's own lifecycle and links to
/// the `Transaction` legs that actually move `Wallet` balances. New fields on this NEW table use the
/// "VIO Credits" naming convention (operator terminology correction); the legacy `Wallet`/`Transaction`
/// fields referenced by id here are intentionally left unrenamed (would break Tourism/AI-gateway).
model VionaRequestEscrowHold {
  id                   String                        @id @default(uuid())
  requestId            String
  actionId             String
  userId               String
  /// Computed at (1) ESTIMATE — never written to after HOLD.
  estimatedAmountVIO   Float
  /// Written at (2) HOLD — the amount actually moved into `Wallet.lockedBalanceVIG`.
  heldAmountVIO        Float
  /// Written at (4) SETTLE — the real, final cost (<= heldAmountVIO always; never negative).
  settledAmountVIO     Float?
  /// Written at (4) REFUND — heldAmountVIO - settledAmountVIO once resolved.
  refundedAmountVIO    Float?
  status               VionaRequestEscrowHoldStatus @default(HELD)
  /// The `ESCROW_LOCK`-type `Transaction.id` created at (2) HOLD (existing `Transaction` table, id only — no Prisma relation).
  holdTransactionId    String                        @unique
  /// The `VIONA_REQUEST_EXECUTION_SETTLED`-type `Transaction.id` created at (4), if any real cost was incurred.
  settleTransactionId  String?                       @unique
  /// The `ESCROW_REFUND`-type `Transaction.id` created at (4), if any refund occurred.
  refundTransactionId  String?                       @unique
  /// Prevents a caller retry from double-holding for the same requestId+actionId attempt.
  idempotencyKey       String                        @unique
  createdAt            DateTime                      @default(now())
  settledAt            DateTime?

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, actionId])
  @@index([userId, status])
}

enum VionaRequestEscrowHoldStatus {
  HELD
  SETTLED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

/// Pack40D1 — durable execution-attempt lifecycle for indirect VionaRequest execution (schema only in D1).
enum VionaRequestExecutionAttemptState {
  claimed
  providerPending
  providerSucceeded
  providerFailed
  outcomeUncertain
  completed
  failed
  abandoned
}

/// Pack40D1 — persisted execution principal category (initial merchant-service scope only).
enum VionaRequestExecutionPrincipalType {
  merchantService
}

/// Pack40D1 — trusted production trigger that created the execution principal.
enum VionaRequestExecutionTriggerType {
  signedMerchantWebhook
  internalAuthenticatedController
  approvedInternalDispatch
}

/// Pack40D1 — one durable execution attempt bound to a single VionaRequest (audit/recovery record).
model VionaRequestExecutionAttempt {
  id                              String                              @id @default(uuid())
  requestId                       String
  attemptNumber                   Int
  executionKey                    String                              @unique
  state                           VionaRequestExecutionAttemptState
  correlationId                   String
  principalType                   VionaRequestExecutionPrincipalType
  triggerType                     VionaRequestExecutionTriggerType
  triggeringUserId                String?
  ownerUserIdSnapshot             String
  scopeKindSnapshot               VionaRequestScopeKind
  merchantProfileIdSnapshot       String?
  tenantIdSnapshot                String
  leaseOwner                      String?
  leaseExpiresAt                  DateTime?
  /// Pack40DR1 — monotonic lease fence for future recovery ownership CAS (runtime unused in DR1).
  leaseGeneration                 Int                                 @default(0)
  claimedAt                       DateTime?
  providerName                    String?
  operationCategory               String?
  providerIdempotencyKey          String?                             @unique
  providerStartedAt               DateTime?
  providerFinishedAt              DateTime?
  providerResultDigest            String?
  providerExternalReferenceDigest String?
  /// Pack40DR1 — exact opaque provider-issued reference for future exact-message reconciliation.
  /// Durable DB value; never expose in public APIs/logs/evidence. Partial unique index is migration-managed.
  providerExternalReference       String?                             @db.VarChar(191)
  failureClass                    String?
  failureReasonDigest             String?
  finalizedAt                     DateTime?
  abandonedAt                     DateTime?
  createdAt                       DateTime                            @default(now())
  updatedAt                       DateTime                            @updatedAt

  request VionaRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, attemptNumber])
  @@index([requestId])
  @@index([requestId, state])
  @@index([state, leaseExpiresAt])
  @@index([correlationId])
}
