# VIONA Express REST API — staging image (Fly.io fra). Not the Expo client bundle.
FROM node:22-bookworm-slim AS base
WORKDIR /app

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma

# Monorepo lockfile includes Expo client deps (e.g. react-native-fast-image → react ^17|^18);
# API image still only runs Express. legacy-peer-deps avoids ERESOLVE on react 19.
RUN npm ci --legacy-peer-deps

COPY src ./src
COPY tsconfig.json ./

RUN npx prisma generate

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["npx", "tsx", "src/server.ts"]
